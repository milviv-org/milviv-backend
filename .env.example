# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/milviv
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=30000

# HTTP Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Application Configuration
APP_NAME=MILVIV
APP_VERSION=1.0.0
APP_ENVIRONMENT=development

# Logging Configuration
LOGGING_LEVEL=INFO
LOGGING_FILE_PATH=logs/application.log

# Authentication
# Обязателен, не короче 32 байт. Сгенерировать: openssl rand -base64 48
AUTH_JWT_SECRET=
# Остальное — необязательно, ниже дефолты
# AUTH_JWT_ISSUER=milviv
# AUTH_ACCESS_TOKEN_TTL_MINUTES=15
# AUTH_REFRESH_TOKEN_TTL_DAYS=30
# AUTH_SESSION_MAX_DAYS=90
# AUTH_COOKIE_SECURE=true
# AUTH_BCRYPT_COST=12
# AUTH_LOGIN_MAX_ATTEMPTS=5
# AUTH_LOGIN_WINDOW_MINUTES=15

# Календарь: самый длинный период за один запрос, дней
# CALENDAR_MAX_DAYS=62

# Рефлексия: сколько своих вопросов может создать пользователь
# REFLECTION_MAX_OWN_QUESTIONS=100

# Статистика: самый длинный период сводки за один запрос, дней
# STATISTICS_MAX_DAYS=366

# AI Assistant — лимиты; задавайте только то, что отличается от дефолта
# AI_PROVIDER=none    # none — AI недоступен; gemini — нужны AI_MODEL и GEMINI_API_KEY
# AI_MODEL=    # модель Gemini, например текущая Flash; смена модели — онлайн-прогон
# GEMINI_API_KEY=    # ключ Google AI Studio; только здесь или в env, не в application.properties
# AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# AI_MAX_OUTPUT_TOKENS=8192    # выходных токенов на вызов
# AI_TEMPERATURE=0.4
# AI_CONNECT_TIMEOUT_MS=5000
# AI_CALL_TIMEOUT_MS=30000    # один вызов Gemini, мс
# AI_TRANSPORT_RETRIES=2    # ретраев на 5xx, таймаут, кратковременный 429
# AI_RESPONSE_MAX_BYTES=65536    # предел ответа Gemini
# AI_MESSAGE_MAX_LENGTH=2000    # длина сообщения
# AI_USER_REQUESTS_PER_DAY=20    # запросов на пользователя в сутки
# AI_USER_REQUESTS_PER_MINUTE=3    # и в минуту
# AI_MAX_CALLS_PER_REQUEST=4    # вызовов AI на запрос
# AI_REQUEST_TIMEOUT_MS=90000    # весь запрос, мс
# AI_PLAN_TTL_HOURS=24    # срок жизни предложения, ч
# AI_MAX_CREATED_PER_DAY=200    # созданий через AI в сутки
# AI_QUOTA_BREAKER_MINUTES=60    # пауза после исчерпания квоты провайдера, мин
# AI_MAX_DATA_ROUNDS=2    # раундов запроса данных
# AI_MAX_DATA_REQUESTS_PER_ROUND=3    # запросов данных за раунд
# AI_DATA_MAX_ITEMS=100    # элементов на запрос данных
# AI_DATA_TEXT_MAX_LENGTH=1000    # длина текста в данных
# AI_DATA_MAX_TOKENS=16000    # данных, отданных AI, токенов
# AI_MAX_CREATES=40    # созданий в плане
# AI_MAX_UPDATES=20    # изменений в плане
# AI_MAX_DELETES=10    # удалений в плане
# AI_MAX_PROJECTS=10    # проектов в плане
# AI_MAX_TASKS_PER_NODE=10    # задач в одном узле
# AI_MAX_TASKS_TOTAL=30    # задач в плане
# AI_MAX_REWARDS=3    # наград в плане
# AI_TITLE_MAX_LENGTH=100    # длина названия от AI
# AI_DESCRIPTION_MAX_LENGTH=1000    # длина описания от AI
# AI_SUMMARY_MAX_LENGTH=500    # длина пояснения AI
# AI_ANSWER_MAX_LENGTH=2000    # длина ответа AI
# AI_CLARIFICATION_MAX_LENGTH=300    # длина уточняющего вопроса AI
# AI_DATA_REQUEST_REASON_MAX_LENGTH=200    # длина причины запроса данных
# AI_DATE_HORIZON_YEARS=2    # даты от AI не дальше, лет
# AI_REWARD_COST_MAX=100000    # стоимость награды от AI
# AI_MEMORY_MAX_ITEMS=20    # записей в памяти AI
# AI_MEMORY_MAX_LENGTH=500    # длина записи памяти AI
