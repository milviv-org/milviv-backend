# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/milviv
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=30000

# HTTP Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Application Configuration
APP_NAME=MILVIV
APP_VERSION=1.0.0
APP_ENVIRONMENT=development

# Logging Configuration
LOGGING_LEVEL=INFO
LOGGING_FILE_PATH=logs/application.log

# Authentication
# Обязателен, не короче 32 байт. Сгенерировать: openssl rand -base64 48
AUTH_JWT_SECRET=
# Остальное — необязательно, ниже дефолты
# AUTH_JWT_ISSUER=milviv
# AUTH_ACCESS_TOKEN_TTL_MINUTES=15
# AUTH_REFRESH_TOKEN_TTL_DAYS=30
# AUTH_SESSION_MAX_DAYS=90
# AUTH_COOKIE_SECURE=true
# AUTH_BCRYPT_COST=12
# AUTH_LOGIN_MAX_ATTEMPTS=5
# AUTH_LOGIN_WINDOW_MINUTES=15

# Календарь: самый длинный период за один запрос, дней
# CALENDAR_MAX_DAYS=62

# Рефлексия: сколько своих вопросов может создать пользователь
# REFLECTION_MAX_OWN_QUESTIONS=100
